/dts-v1/;

#include "sg2002.dtsi"

/ {
	model = "Citro7";
	compatible = "sipeed,licheerv-nano-b", "sipeed,licheerv-nano", "sophgo,sg2002";

	aliases {
		gpio0 = &gpio0;
		gpio1 = &gpio1;
		gpio2 = &gpio2;
		gpio3 = &gpio3;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&osc {
	clock-frequency = <25000000>;
};

&pinctrl {
	uart0_cfg: uart0-cfg {
		uart0-pins {
			pinmux = <PINMUX(PIN_UART0_TX, 0)>,
				 <PINMUX(PIN_UART0_RX, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	i2c1_cfg: i2c1-cfg {
		i2c1-pins {
			pinmux = <PINMUX(PIN_SD1_D3, 2)>,
				 <PINMUX(PIN_SD1_D0, 2)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	i2c3_cfg: i2c3-cfg {
		i2c3-pins {
			pinmux = <PINMUX(PIN_SD1_CMD, 2)>,
				 <PINMUX(PIN_SD1_CLK, 2)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	pwm1_cfg: pwm1-cfg {
		pwm1-pins {
			pinmux = <PINMUX(PIN_JTAG_CPU_TCK, 2)>,
				 <PINMUX(PIN_JTAG_CPU_TMS, 2)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	sdhci0_cfg: sdhci0-cfg {
		sdhci0-clk-pins {
			pinmux = <PINMUX(PIN_SD0_CLK, 0)>;
			bias-pull-up;
			drive-strength-microamp = <16100>;
			power-source = <3300>;
		};

		sdhci0-cmd-pins {
			pinmux = <PINMUX(PIN_SD0_CMD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		sdhci0-data-pins {
			pinmux = <PINMUX(PIN_SD0_D0, 0)>,
				 <PINMUX(PIN_SD0_D1, 0)>,
				 <PINMUX(PIN_SD0_D2, 0)>,
				 <PINMUX(PIN_SD0_D3, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		sdhci0-cd-pins {
			pinmux = <PINMUX(PIN_SD0_CD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};
};

&sdhci0 {
	pinctrl-0 = <&sdhci0_cfg>;
	pinctrl-names = "default";
	status = "okay";
	bus-width = <4>;
	no-1-8-v;
	no-mmc;
	no-sdio;
	disable-wp;
};

&uart0 {
	pinctrl-0 = <&uart0_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_cfg>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
};

&i2c3 {
	status = "okay";
	pinctrl-0 = <&i2c3_cfg>;
	pinctrl-names = "default";
	clock-frequency = <400000>;

        proximity@31 {
            compatible = "st,vl53l0x";
            reg = <0x31>;
        };

        proximity@32 {
            compatible = "st,vl53l0x";
            reg = <0x32>;
        };

        proximity@33 {
            compatible = "st,vl53l0x";
            reg = <0x33>;
        };

        proximity@34 {
            compatible = "st,vl53l0x";
            reg = <0x34>;
        };

        proximity@35 {
            compatible = "st,vl53l0x";
            reg = <0x35>;
        };

        proximity@36 {
            compatible = "st,vl53l0x";
            reg = <0x36>;
        };

	gpio@20 {
		compatible = "nxp,pca9535";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;

		gpio-line-names =
			"tof-1","tof-2",
			"tof-3","tof-4",
			"tof-5","tof-6",
			"","",
			"","",
			"","",
			"","",
			"","";
	};
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_cfg>;
	pinctrl-names = "default";
};
